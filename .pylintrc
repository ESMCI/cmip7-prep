[MASTER]
ignore-paths=build,dist,.venv,.eggs,scripts
extension-pkg-allow-list=cmor
# src/ for the package, scripts/ because the tests import the scripts the way
# the scripts import each other -- through a sys.path insert that pylint does
# not execute, so without this it reports every such import as unresolvable.
init-hook='import sys, os; sys.path.insert(0, os.path.join(os.getcwd(), "src")); sys.path.insert(0, os.path.join(os.getcwd(), "scripts"))'

[MESSAGES CONTROL]
disable=
    too-many-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    invalid-name,
    duplicate-code,
    fixme

[FORMAT]
max-line-length=100

[TYPECHECK]
ignored-modules=xarray,xesmf,cmor,numpy,geocat.comp,yaml,jsonschema,cftime,pytest,dask,gents
ignored-classes=cmor
