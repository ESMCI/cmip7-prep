[MASTER]
ignore-paths=build,dist,.venv,.eggs,scripts
extension-pkg-allow-list=cmor
init-hook='import sys, os; [sys.path.insert(0, os.path.join(os.getcwd(), p)) for p in ("src", "scripts") if os.path.join(os.getcwd(), p) not in sys.path]'

[MESSAGES CONTROL]
disable=
    too-many-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    invalid-name,
    duplicate-code,
    fixme

[FORMAT]
max-line-length=100

[TYPECHECK]
ignored-modules=xarray,xesmf,cmor,numpy,geocat.comp,yaml,cftime,pytest,dask
ignored-classes=cmor
